#!/usr/bin/env bash
#MISE description="encoded_videos の動画を R2 バケットにアップロードする"
#USAGE flag "--series <id>" required=#true help="イベントシリーズID (例: elnino)"
#USAGE flag "--event <id>" required=#true help="イベントID (例: elnino_vol_5)"
#USAGE flag "--all" help="すべての動画をアップロードする"
#USAGE flag "--include <pattern>" help="対象を絞り込む glob パターン (例: 本戦/*.mp4)"
#USAGE flag "--dry-run" help="実際には転送せず、対象のファイルだけを表示する"

set -euo pipefail

cd "${MISE_PROJECT_ROOT:-$(dirname "$0")/..}"

series="${usage_series:-}"
event="${usage_event:-}"
# ID はオブジェクトキーの 1 階層になるので、/ や .. が混ざらないよう文字種を制限する
for id in "$series" "$event"; do
  if [[ ! $id =~ ^[A-Za-z0-9_-]+$ ]]; then
    echo "error: --series / --event には英数字と _ - だけを指定してください: '$id'" >&2
    exit 1
  fi
done

pattern="${usage_include:-}"
if [[ -z $pattern ]]; then
  if [[ ${usage_all:-} == "true" ]]; then
    pattern="*.mp4"
  else
    echo "usage: mise upload --series <id> --event <id> (--all | --include <pattern>)" >&2
    exit 1
  fi
fi

dry_run=()
if [[ ${usage_dry_run:-} == "true" ]]; then
  dry_run=(--dry-run)
fi

src_dir="encoded_videos"

# encode と同じ規則 (bash の glob 照合、* は / もまたぐ) で対象を選ぶため、
# rclone の --include ではなくファイル一覧を渡す
files=()
while IFS= read -r -d '' path; do
  rel="${path#"$src_dir"/}"
  # shellcheck disable=SC2053 # pattern は glob として照合する
  [[ $rel == $pattern ]] || continue
  files+=("$rel")
done < <(find "$src_dir" -type f -name '*.mp4' -print0)

if [[ ${#files[@]} -eq 0 ]]; then
  echo "warning: '$pattern' に一致する動画が $src_dir/ にありません" >&2
  exit 0
fi

# キーは <シリーズID>/<イベントID>/<src_dir からの相対パス> になる
dest="$R2_REMOTE:$R2_BUCKET/$series/$event"
echo "upload to: $dest"

exec rclone copy "$src_dir" "$dest" \
  --files-from-raw <(printf '%s\n' "${files[@]}") \
  --s3-chunk-size 64M \
  --s3-upload-concurrency 4 \
  --transfers 4 \
  --progress \
  "${dry_run[@]}"
